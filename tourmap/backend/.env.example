# ============================================================
# TourMap Backend — Variáveis de Ambiente
# Copie para .env e preencha:  cp .env.example .env
# Em produção (AWS) estes valores vêm do SSM Parameter Store.
# ============================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Banco de Dados (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tourmap

# --- JWT ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- E-mail (SMTP) ---
# on  = cadastro exige o código de 6 dígitos enviado por e-mail
# off = conta já nasce verificada (demonstração sem SMTP)
EMAIL_VERIFICATION=on
# Dev: Mailtrap sandbox (os e-mails ficam presos no painel do Mailtrap).
# Produção: Gmail com "senha de app" (smtp.gmail.com:587) ou outro SMTP real.
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=nao-responda@tourmap.app

# --- Análise de sentimento ---
# local = modelo ONNX roda no próprio backend (padrão, sem custo por chamada)
# api   = Hugging Face Inference API (exige HUGGINGFACE_API_KEY com créditos)
# off   = só o léxico de palavras-chave
SENTIMENT_ENGINE=local
# fp32 = fiel ao modelo original (~540 MB) · q8 = quantizado (~135 MB, muda casos limítrofes)
SENTIMENT_DTYPE=fp32
# Onde guardar os modelos baixados (padrão: backend/.model-cache)
# MODEL_CACHE_DIR=
HUGGINGFACE_API_KEY=

# --- OpenTripMap (só para: node src/config/syncDb.js) ---
OPENTRIPMAP_KEY=

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# Senha do admin criado pelo syncDb e das contas de demonstração dos seeds.
# Vazias = senha aleatória, mostrada uma vez no terminal.
ADMIN_PASSWORD=
SEED_PASSWORD=
