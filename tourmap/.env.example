# Variáveis do docker-compose.yml (para rodar a stack completa localmente).
# cp .env.example .env  e preencha. Em produção este arquivo é gerado na EC2
# a partir do SSM Parameter Store — você não precisa criá-lo lá.

DB_NAME=tourmap
DB_USER=tourmap
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-tambem

JWT_SECRET=
JWT_EXPIRES_IN=7d

# off = cadastro entra direto, sem código por e-mail (não precisa de SMTP)
EMAIL_VERIFICATION=off
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=nao-responda@tourmap.app

SENTIMENT_ENGINE=local
SENTIMENT_DTYPE=fp32
HUGGINGFACE_API_KEY=

# Local: :80 (HTTP) · Produção: preenchido pelo Terraform (ex.: 54-12-34-56.sslip.io)
SITE_ADDRESS=:80
FRONTEND_URL=http://localhost

# Local: tourmap · Produção: <conta>.dkr.ecr.<região>.amazonaws.com
REGISTRY=tourmap
TAG=latest

# Senha do admin criado pelo syncDb e das contas de demonstração dos seeds.
# Vazias = senha aleatória, mostrada uma vez no terminal.
ADMIN_PASSWORD=
SEED_PASSWORD=
